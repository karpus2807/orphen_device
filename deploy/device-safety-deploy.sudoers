# Installed by install-server.sh — allows webhook deploy user to restart services without a password.
__DEPLOY_USER__ ALL=(ALL) NOPASSWD: /bin/systemctl daemon-reload, \
  /bin/systemctl restart device-safety-backend.service, \
  /bin/systemctl is-active device-safety-backend.service, \
  /bin/systemctl restart device-safety-webhook.service, \
  /bin/systemctl is-enabled device-safety-webhook.service
