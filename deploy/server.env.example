# Server runtime (loaded by systemd if referenced in unit file).
DEVICE_SAFETY_PORT=9030
DEVICE_SAFETY_BIND_HOST=0.0.0.0

# Unlimited telemetry/history storage (no 2500-row cap).
DEVICE_SAFETY_UNLIMITED=1

# Optional: cap when UNLIMITED=0
# DEVICE_SAFETY_HISTORY_LIMIT=2500

# Android SDK on server (for Web UI Build APK). Set by setup-all.sh --with-android-sdk
# ANDROID_SDK_ROOT=/opt/android-sdk

# Future: switch backend from SQLite to MySQL (phpMyAdmin uses MariaDB in Docker today)
# DEVICE_SAFETY_USE_MYSQL=0
